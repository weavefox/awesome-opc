---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Awesome OPC - 一人公司的无限可能。汇集政策解读、灵感故事和工具推荐，助力个人创业者成功。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Awesome OPC" />

    <!-- Fonts: Playfair Display for headings, DM Sans for body, Geist for code -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Geist:wght@400;500;600;700;800;900&family=Nunito:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
    <style>
      /* Prevent font flash */
      .font-logo {
        font-family: var(--font-logo), system-ui, -apple-system, sans-serif;
        font-display: swap;
      }
    </style>

    <!-- Icons -->
    <script src="https://unpkg.com/lucide@0.454.0/dist/umd/lucide.js"></script>
  </head>
  <body class="bg-white text-on-surface font-inter min-h-screen">
    <slot />
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (window.lucide) {
          lucide.createIcons();
        } else {
          // Fallback: retry after a short delay
          setTimeout(() => lucide && lucide.createIcons(), 100);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'Geist', 'SF Mono', Consolas, monospace;
    /* Logo uses system rounded font to avoid loading flash */
    --font-logo: -apple-system, 'BlinkMacSystemFont', 'Segoe UI Rounded', 'Nunito', system-ui, sans-serif;
  }

  body {
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Headings use Playfair Display */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Logo - use system font immediately with webfont as fallback */
  .font-logo {
    font-family: var(--font-logo);
    font-weight: 700;
    /* Preload font-display to prevent layout shift */
    font-display: optional;
  }

  /* Code and labels use Geist */
  code, pre, .font-mono {
    font-family: var(--font-mono);
  }

  .lucide {
    display: inline-block;
    vertical-align: middle;
  }
</style>